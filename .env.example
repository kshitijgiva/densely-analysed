# Chat defaults to simple keyword routing (no external LLM).
CHAT_MODE=simple

# Only needed if CHAT_MODE=llm
LITELLM_BASE_URL=https://litellm.internal.givadiva.co
LITELLM_API_KEY=sk-your-key-here
LITELLM_MODEL=gpt-4o

# Only needed when running render_tracked_video.py --persist - uploads the
# generated heatmap PNG and stores its public URL for /overview to serve.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Google Drive downloads (analytics jobs on :8090) ---
# A plain API key cannot download private files. Use one of:
#
# A) OAuth (recommended when YOU have Viewer access to someone else's file):
#    1. Google Cloud Console → create OAuth Desktop client → download JSON
#    2. First job opens a browser once; token is cached at GOOGLE_DRIVE_TOKEN_PATH
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRETS=/absolute/path/to/client_secret.json
# GOOGLE_DRIVE_TOKEN_PATH=/absolute/path/to/google_drive_token.json
#
# B) Service account (share the Drive file with the SA email as Viewer):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# # or: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# With neither set, jobs use public gdown ("Anyone with the link" only).
